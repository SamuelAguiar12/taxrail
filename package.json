{
  "name": "taxrail-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "TaxRail — The Autonomous Tax-Optimization Rail for AI Agents (US + Brazil)",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "dev:worker": "pnpm --filter @taxrail/edge-worker dev",
    "deploy:dry-run": "pnpm --filter @taxrail/edge-worker exec wrangler deploy --dry-run",
    "bazaar:settle": "pnpm --filter @taxrail/edge-worker exec node --experimental-strip-types scripts/trigger-bazaar-settlement.mts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.2"
  }
}
