{
  "name": "taxrail-mcp",
  "mcpName": "io.github.SamuelAguiar12/taxrail",
  "version": "0.2.0",
  "type": "module",
  "description": "TaxRail MCP Server (7 tools) — Autonomous US & Brazil crypto/DeFi/corporate tax optimization, TLH wallet scan, pre-trade guardrails & Brazil R$35k check via x402",
  "license": "MIT",
  "homepage": "https://api.taxrail.online",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SamuelAguiar12/taxrail.git",
    "directory": "packages/mcp-cli"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "x402",
    "tax",
    "crypto-tax",
    "ai-agents",
    "defi",
    "aave",
    "irs",
    "brazil",
    "base",
    "usdc"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "bin": {
    "taxrail-mcp": "dist/index.js"
  },
  "main": "./dist/index.js",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --external:@modelcontextprotocol/* --external:zod --external:viem && chmod +x dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "viem": "^2.58.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@taxrail/execution": "workspace:*",
    "@taxrail/shared": "workspace:*",
    "@taxrail/tax-engine": "workspace:*",
    "esbuild": "^0.28.2"
  }
}
